menu "Delta Omega User Behaviors"

config ZMK_RAPID_FIRE_MIN_INTERVAL_MS
    int "Rapid-fire minimum interval in milliseconds"
    default 20
    range 5 1000

config ZMK_RAPID_FIRE_MAX_INTERVAL_MS
    int "Rapid-fire maximum interval in milliseconds"
    default 26
    range 5 1000

config ZMK_RAPID_FIRE_TAP_MS
    int "Rapid-fire virtual tap duration in milliseconds"
    default 1
    range 1 100

config ZMK_DEBOUNCE_TAP_COOLDOWN_MS
    int "Debounce-tap: minimum gap between fires on the same position"
    default 30
    range 5 200
    help
      A repeat trigger on the same position within this window of the
      last one is treated as switch chatter and ignored.

config ZMK_DEBOUNCE_TAP_MS
    int "Debounce-tap: virtual tap duration in milliseconds"
    default 5
    range 1 100

config ZMK_SPACE_HT_TAPPING_TERM_MS
    int "Space hold-tap: tapping term in milliseconds"
    default 190
    range 50 500

config ZMK_SPACE_HT_RELEASE_GRACE_MS
    int "Space hold-tap: grace period after release before deactivating the hold layer"
    default 40
    range 5 200
    help
      If the key is pressed again within this window after releasing
      while the hold layer is active, the release is treated as switch
      chatter and the hold continues uninterrupted.

endmenu
