#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define KOR    0
#define ENG    1
#define NAV    2
#define NUM    3
#define FUN    4
#define UTIL   5
#define MAPLE  6
#define MUTIL  7
#define SYM    8

/ {
    behaviors {
        /*
         * GACS mirrored home-row mods for typing layers only.
         *
         * Left:  A/N = GUI, S/R = ALT, D/T = CTRL, F/S = SHIFT
         * Right: J/H = SHIFT, K/A = CTRL, L/E = ALT, ;/I = GUI
         *
         * Positional hold-tap: holds are favored only when the
         * opposite hand (or a thumb) participates.
         */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                5 6 7 8 9
                15 16 17 18 19
                25 26 27 28 29
                30 31 32 33
            >;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14
                20 21 22 23 24
                30 31 32 33
            >;
            hold-trigger-on-release;
        };

        /*
         * MAPLE thumb dual-role behaviors.
         * Tap values stay exactly in the user's physical thumb order:
         * ESC / SPACE / BACKSPACE / ENTER.
         *
         * Only rarely-held thumbs receive a game hold action:
         * ESC hold  -> Ctrl
         * BSPC hold -> Alt
         *
         * hold-preferred makes modifier chords resolve as hold as soon
         * as another key is pressed.
         */
        gmod: game_modifier {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <80>;
            bindings = <&kp>, <&kp>;
        };

        /*
         * ENTER tap -> Enter
         * ENTER hold -> M-UTIL while held.
         */
        gutil: game_utility {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <100>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * KOR: QWERTY for Korean 2-set IME.
         *
         * Q W E R T   Y U I O P
         * A S D F G   H J K L ;
         * Z X C V B   N M , . /
         *
         * Thumbs, physical left -> right:
         * Esc/UTIL | Space/NAV || Backspace/FUN | Enter/NUM
         */
        KOR {
            bindings = <
&kp Q          &kp W          &kp E           &kp R            &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P
&hml LGUI A     &hml LALT S    &hml LCTRL D    &hml LSHIFT F    &kp G           &kp H           &hmr RSHIFT J   &hmr RCTRL K    &hmr RALT L     &hmr RGUI SEMI
&kp Z          &kp X          &kp C           &kp V            &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp SLASH
                                                     &lt UTIL ESC   &lt NAV SPACE   &lt FUN BACKSPACE   &lt NUM ENTER
            >;
        };

        /*
         * ENG: Gallium Colstag.
         *
         * B L D C V   J Y O U ,
         * N R T S G   P H A E I
         * X Q M W Z   K F ' ; .
         *
         * Same physical HRM positions and same thumb order as KOR.
         */
        ENG {
            bindings = <
&kp B          &kp L          &kp D           &kp C            &kp V           &kp J           &kp Y           &kp O           &kp U           &kp COMMA
&hml LGUI N     &hml LALT R    &hml LCTRL T    &hml LSHIFT S    &kp G           &kp P           &hmr RSHIFT H   &hmr RCTRL A    &hmr RALT E     &hmr RGUI I
&kp X          &kp Q          &kp M           &kp W            &kp Z           &kp K           &kp F           &kp APOS        &kp SEMI        &kp DOT
                                                     &lt UTIL ESC   &lt NAV SPACE   &lt FUN BACKSPACE   &lt NUM ENTER
            >;
        };

        /*
         * NAV: typing/navigation layer, held from Space.
         * Left hand has plain modifiers; right hand has navigation/editing.
         */
        NAV {
            bindings = <
&kp ESC        &kp TAB        &kp LGUI        &kp LALT         &kp LCTRL       &kp HOME        &kp PG_UP       &kp UP          &kp PG_DN       &kp END
&kp LGUI       &kp LALT       &kp LCTRL       &kp LSHIFT       &trans          &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &kp DEL
&trans         &trans         &trans          &trans           &trans          &kp INS         &kp HOME        &kp PG_DN       &kp PG_UP       &kp END
                                                     &trans         &trans          &trans          &trans
            >;
        };

        /*
         * NUM: normal number-row HID keycodes (NOT keypad usages),
         * arranged numpad-style on the right hand.
         */
        NUM {
            bindings = <
&trans         &trans         &trans          &trans           &trans          &kp N7          &kp N8          &kp N9          &kp MINUS       &kp EQUAL
&trans         &trans         &trans          &trans           &trans          &kp N4          &kp N5          &kp N6          &kp LBKT        &kp RBKT
&trans         &trans         &trans          &trans           &trans          &kp N1          &kp N2          &kp N3          &kp N0          &kp DOT
                                                     &trans         &trans          &trans          &trans
            >;
        };

        /*
         * FUN: F1-F12 + editing/navigation.
         * Held from Backspace on KOR/ENG.
         */
        FUN {
            bindings = <
&kp F1         &kp F2         &kp F3          &kp F4           &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10
&kp F11        &kp F12        &kp DEL         &kp INS          &kp PSCRN       &kp HOME        &kp PG_UP       &kp PG_DN       &kp END         &kp CAPS
&trans         &trans         &trans          &trans           &trans          &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &kp LANG1
                                                     &trans         &trans          &trans          &trans
            >;
        };

        /*
         * UTIL: held from Esc on KOR/ENG.
         * Direct persistent mode selection with &to.
         */
        UTIL {
            bindings = <
&to KOR        &to ENG        &to MAPLE       &kp LANG1        &kp CAPS        &kp ESC         &kp TAB         &kp INS         &kp DEL         &kp PSCRN
&kp LGUI       &kp LALT       &kp LCTRL       &kp LSHIFT       &studio_unlock  &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &trans
&trans         &trans         &trans          &trans           &trans          &kp HOME        &kp PG_DN       &kp PG_UP       &kp END         &trans
                                                     &trans         &trans          &trans          &trans
            >;
        };

        /*
         * MAPLE: game-first persistent layer.
         *
         * 26 alphabet keys + direct inverted-T arrows occupy all 30
         * non-thumb positions. No HRM is used on any alphabet key.
         *
         * Q W E R T   Y U ↑ O P
         * A S D F G   H ← ↓ → I
         * Z X C V B   N M J K L
         *
         * Thumb taps stay exactly:
         * ESC | SPACE || BACKSPACE | ENTER
         *
         * Game holds:
         * ESC hold       -> Ctrl
         * BACKSPACE hold -> Alt
         * ENTER hold     -> M-UTIL
         */
        MAPLE {
            bindings = <
&kp Q          &kp W          &kp E           &kp R            &kp T           &kp Y           &kp U           &kp UP          &kp O           &kp P
&kp A          &kp S          &kp D           &kp F            &kp G           &kp H           &kp LEFT        &kp DOWN        &kp RIGHT       &kp I
&kp Z          &kp X          &kp C           &kp V            &kp B           &kp N           &kp M           &kp J           &kp K           &kp L
                                                     &gmod LCTRL ESC   &kp SPACE      &gmod LALT BACKSPACE   &gutil MUTIL ENTER
            >;
        };

        /*
         * M-UTIL: hold Enter from MAPLE.
         *
         * Main 30:
         * 1..0, F1..F10, F11/F12, KOR/ENG exit, Ins/Home/End/PgUp/PgDn/Del
         *
         * While Enter is held for M-UTIL, the other three thumbs become:
         * Shift | Ctrl | Alt
         */
        MUTIL {
            bindings = <
&kp N1         &kp N2         &kp N3          &kp N4           &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0
&kp F1         &kp F2         &kp F3          &kp F4           &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10
&kp F11        &kp F12        &to KOR         &to ENG          &kp INS         &kp HOME        &kp END         &kp PG_UP       &kp PG_DN       &kp DEL
                                                     &kp LSHIFT     &kp LCTRL       &kp LALT        &trans
            >;
        };

        /*
         * SYM: automatically becomes active while NUM + FUN are both held
         * (Enter + Backspace holds on KOR/ENG).
         */
        SYM {
            bindings = <
&kp GRAVE      &kp EXCL       &kp AT          &kp HASH         &kp DOLLAR      &kp PERCENT     &kp CARET       &kp AMPS        &kp ASTRK       &kp PLUS
&kp TILDE      &kp MINUS      &kp EQUAL       &kp LPAR         &kp LBKT        &kp RBKT        &kp RPAR        &kp APOS        &kp DQT         &kp PIPE
&kp UNDER      &kp LT         &kp GT          &kp LBRC         &kp BSLH        &kp FSLH        &kp RBRC        &kp SEMI        &kp COLON       &kp QMARK
                                                     &trans         &trans          &trans          &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        symbol_layer {
            if-layers = <NUM FUN>;
            then-layer = <SYM>;
        };
    };
};
