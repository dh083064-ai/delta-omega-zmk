#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define KOR    0
#define ENG    1
#define NAV    2
#define FN     3
#define NUM    4
#define SYS    5
#define MOUSE  6

/*
 * Ported from urob/zmk-config (github.com/urob/zmk-config), adapted to the
 * Delta Omega's 34-key 3x5+2 layout. KOR/ENG (base typing layers + HRM) are
 * unchanged from before. NAV/FN/NUM/SYS/MOUSE and the combo set below
 * replace the old NAV_MOUSE/NUM_FUN/SYM layers. MAPLE/MUTIL removed for
 * this pass.
 *
 * Physical position numbers (unchanged project convention):
 *   row0: 0-4 (left) 5-9 (right)
 *   row1: 10-14 (left) 15-19 (right)
 *   row2: 20-24 (left) 25-29 (right)
 *   thumbs: 30(ESC) 31(SPACE) 32(BACKSPACE) 33(ENTER)
 */

&sk {
    release-after-ms = <900>;
    quick-release;
};

&sl {
    ignore-modifiers;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

/ {
    dbtap: debounce_tap {
        compatible = "zmk,behavior-debounce-tap";
        #binding-cells = <1>;
    };

    space_ht: space_holdtap {
        compatible = "zmk,behavior-space-holdtap";
        #binding-cells = <2>;
    };

    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                5 6 7 8 9
                15 16 17 18 19
                25 26 27 28 29
                30 31 32 33
            >;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14
                20 21 22 23 24
                30 31 32 33
            >;
            hold-trigger-on-release;
        };

        /* Tap Esc, hold to switch KOR <-> ENG. */
        bsw: base_switch {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&to>, <&kp>;
        };

        /*
         * Backspace: tap = one delete, hold = NUM.
         * tap-then-hold within quick-tap window = normal repeating Backspace.
         */
        bsplt: backspace_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            bindings = <&mo>, <&kp>;
        };

        /* Mask CTRL on long-tap Left/Right nav to avoid jumping to doc start/end. */
        masked_home: masked_home {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp HOME>, <&kp HOME>;
            mods = <(MOD_LCTL)>;
        };
        masked_end: masked_end {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp END>, <&kp END>;
            mods = <(MOD_LCTL)>;
        };

        /* Trigger tap-action on all interrupts; used for Nav's long-tap keys. */
        mt_home: mt_home {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <220>;
            bindings = <&masked_home>, <&kp>;
        };
        mt_end: mt_end {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <220>;
            bindings = <&masked_end>, <&kp>;
        };
        mt_ctrl: mt_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <220>;
            bindings = <&kp>, <&kp>;
        };

        /* Alt+Tab swapper - hold Alt, tap Tab repeatedly, release to commit. */
        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
            ignored-key-positions = <7 17 26 27 28>;
        };

        /* Toggle the Mouse layer; typing other keys while it's on cancels it. */
        smart_mouse: smart_mouse {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&tog MOUSE>, <&none>, <&tog MOUSE>;
            ignored-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
            ignored-layers = <MOUSE NAV FN>;
        };

        /* Tap: comma | Shift+tap: semicolon | Ctrl+Shift+tap: less-than. */
        comma_inner_morph: comma_inner_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp LT>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        comma_morph: comma_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&comma_inner_morph>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Tap: dot | Shift+tap: colon | Ctrl+Shift+tap: greater-than. */
        dot_inner_morph: dot_inner_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp GT>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        dot_morph: dot_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&dot_inner_morph>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Tap: question mark | Shift+tap: exclamation mark. */
        qexcl: qexcl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Tap: ( / ) | Shift+tap: < / >. */
        lpar_lt: lpar_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp LT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        rpar_gt: rpar_gt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp GT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Tap: backspace | Lshift+tap: delete | Rshift+tap: shift-delete. */
        bs_del: bs_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        /* Tap: copy | double-tap: cut. */
        copy_cut: copy_cut {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LC(INS)>, <&kp LC(X)>;
        };

        /* Tap: num-word (auto-off after one key) | Hold: NUM layer. */
        smart_num: smart_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&num_word>;
        };

        /* Sticky shift + leader key, chained via a macro. */
        leader_sft: leader_sft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LSHFT>, <&leader>;
        };

        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            ignore-keys = <LSHFT RSHFT>;

            seq_usb {
                bindings = <&out OUT_USB>;
                sequence = <U S B>;
            };
            seq_ble {
                bindings = <&out OUT_BLE>;
                sequence = <B L E>;
            };
            seq_reset {
                bindings = <&sys_reset>;
                sequence = <R E S E T>;
            };
            seq_boot {
                bindings = <&bootloader>;
                sequence = <B O O T>;
            };
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Existing K/L physical-position combo for Korean/English IME toggle. */
        combo_hangeul {
            timeout-ms = <110>;
            key-positions = <17 18>;
            layers = <KOR ENG>;
            bindings = <&kp RALT>;
        };

        /* Left top row: Esc / toggle Mouse layer. */
        combo_esc {
            timeout-ms = <18>;
            key-positions = <1 2>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp ESC>;
        };
        combo_mouse {
            timeout-ms = <18>;
            key-positions = <2 3>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&smart_mouse>;
        };

        /* Left home row: leader sequences. */
        combo_ldr {
            timeout-ms = <18>;
            key-positions = <12 13>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&leader>;
        };
        combo_ldrsh {
            timeout-ms = <18>;
            key-positions = <11 12 13>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&leader_sft>;
        };

        /* Left bottom row: cut/copy/paste. */
        combo_cut {
            timeout-ms = <18>;
            key-positions = <21 23>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp LC(X)>;
        };
        combo_copy {
            timeout-ms = <18>;
            key-positions = <21 22>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp LC(INS)>;
        };
        combo_paste {
            timeout-ms = <18>;
            key-positions = <22 23>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp LS(INS)>;
        };

        /* Right top row: backspace/delete. */
        combo_bspc {
            timeout-ms = <18>;
            key-positions = <6 7>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp BSPC>;
        };
        combo_del {
            timeout-ms = <18>;
            key-positions = <7 8>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp DEL>;
        };

        /* Right home row: parens (base/num) or angle brackets (nav). */
        combo_lpar {
            timeout-ms = <18>;
            key-positions = <16 17>;
            layers = <KOR ENG NUM>;
            bindings = <&lpar_lt>;
        };
        combo_rpar {
            timeout-ms = <18>;
            key-positions = <17 18>;
            layers = <KOR ENG NUM>;
            bindings = <&rpar_gt>;
        };
        combo_lt {
            timeout-ms = <18>;
            key-positions = <16 17>;
            layers = <NAV>;
            bindings = <&kp LT>;
        };
        combo_gt {
            timeout-ms = <18>;
            key-positions = <17 18>;
            layers = <NAV>;
            bindings = <&kp GT>;
        };

        /* Right bottom row: square/curly brackets. */
        combo_lbkt {
            timeout-ms = <18>;
            key-positions = <26 27>;
            layers = <KOR ENG NUM>;
            bindings = <&kp LBKT>;
        };
        combo_rbkt {
            timeout-ms = <18>;
            key-positions = <27 28>;
            layers = <KOR ENG NUM>;
            bindings = <&kp RBKT>;
        };
        combo_lbrc {
            timeout-ms = <18>;
            key-positions = <26 27>;
            layers = <NAV>;
            bindings = <&kp LBRC>;
        };
        combo_rbrc {
            timeout-ms = <18>;
            key-positions = <27 28>;
            layers = <NAV>;
            bindings = <&kp RBRC>;
        };

        /* Left vertical combos (top+home per column): @ # $ %. */
        combo_at {
            timeout-ms = <30>;
            key-positions = <1 11>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp AT>;
        };
        combo_hash {
            timeout-ms = <30>;
            key-positions = <2 12>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp HASH>;
        };
        combo_dllr {
            timeout-ms = <30>;
            key-positions = <3 13>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp DOLLAR>;
        };
        combo_prcnt {
            timeout-ms = <30>;
            key-positions = <4 14>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp PERCENT>;
        };

        /* Left vertical combos (home+bottom per column): ` \ = ~. */
        combo_grave {
            timeout-ms = <30>;
            key-positions = <11 21>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp GRAVE>;
        };
        combo_bslh {
            timeout-ms = <30>;
            key-positions = <12 22>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp BSLH>;
        };
        combo_equal {
            timeout-ms = <30>;
            key-positions = <13 23>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp EQUAL>;
        };
        combo_tilde {
            timeout-ms = <30>;
            key-positions = <14 24>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp TILDE>;
        };

        /* Right vertical combos (top+home per column): ^ + * &. */
        combo_caret {
            timeout-ms = <30>;
            key-positions = <5 15>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp CARET>;
        };
        combo_plus {
            timeout-ms = <30>;
            key-positions = <6 16>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp PLUS>;
        };
        combo_star {
            timeout-ms = <30>;
            key-positions = <7 17>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp ASTRK>;
        };
        combo_amps {
            timeout-ms = <30>;
            key-positions = <8 18>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp AMPS>;
        };

        /* Right vertical combos (home+bottom per column): _ - / |. */
        combo_under {
            timeout-ms = <30>;
            key-positions = <15 25>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp UNDER>;
        };
        combo_minus {
            timeout-ms = <30>;
            key-positions = <16 26>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp MINUS>;
        };
        combo_fslh {
            timeout-ms = <30>;
            key-positions = <17 27>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp FSLH>;
        };
        combo_pipe {
            timeout-ms = <30>;
            key-positions = <18 28>;
            layers = <KOR ENG NAV NUM>;
            bindings = <&kp PIPE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_layer {
            if-layers = <FN NUM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Korean QWERTY + HRM */
        KOR {
            bindings = <
&kp Q          &kp W          &kp E           &kp R            &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P
&hml LGUI A     &hml LALT S    &hml LCTRL D    &hml LSHIFT F    &kp G           &kp H           &hmr RSHIFT J   &hmr RCTRL K    &hmr RALT L     &hmr RGUI SEMI
&kp Z          &kp X          &kp C           &kp V            &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp SLASH
                                                    &bsw ENG ESC   &space_ht NAV SPACE   &bsplt NUM BACKSPACE   &lt FN ENTER
            >;
        };

        /* Gallium Colstag + HRM */
        ENG {
            bindings = <
&kp B          &kp L          &kp D           &kp C            &kp V           &kp J           &kp Y           &kp O           &kp U           &kp COMMA
&hml LGUI N     &hml LALT R    &hml LCTRL T    &hml LSHIFT S    &kp G           &kp P           &hmr RSHIFT H   &hmr RCTRL A    &hmr RALT E     &hmr RGUI I
&kp X          &kp Q          &kp M           &kp W            &kp Z           &kp K           &kp F           &kp APOS        &kp SEMI        &kp DOT
                                                    &bsw KOR ESC   &space_ht NAV SPACE   &bsplt NUM BACKSPACE   &lt FN ENTER
            >;
        };

        /*
         * Nav cluster. Right home row = arrows (long-tap: line/doc start-end).
         * Right top = PgUp/Bspc-word/Up/Del-word. Left = sticky mods.
         */
        NAV {
            bindings = <
&kp LA(F4)     &trans         &kp LS(TAB)     &swapper         &trans          &kp PG_UP       &mt_ctrl LC(BSPC) BSPC   &mt_home 0 UP   &mt_ctrl LC(DEL) DEL   &trans
&sk LGUI       &sk LALT       &sk LSHFT       &sk LCTRL        &trans          &kp PG_DN       &mt_home 0 LEFT          &mt_ctrl LC(END) DOWN   &mt_end 0 RIGHT   &kp RET
&trans         &trans         &trans          &trans           &trans          &kp INS         &kp TAB         &trans          &trans          &trans
                                                    &trans         &trans          &trans          &kp K_CANCEL
            >;
        };

        /*
         * Fn: F-keys + media/desktop. Left column mirrors F-keys with HRM.
         */
        FN {
            bindings = <
&kp F12        &kp F7         &kp F8          &kp F9           &trans          &trans          &kp C_PREV      &kp C_VOL_UP    &kp C_NEXT      &trans
&hml LGUI F11   &hml LALT F4   &hml LSHFT F5   &hml LCTRL F6    &trans          &trans          &hmr LCTRL LG(LC(LEFT))   &hmr RSHFT C_VOL_DN   &hmr LALT LG(LC(RIGHT))   &trans
&kp F10        &kp F1         &kp F2          &kp F3           &trans          &kp LG(LC(LS(A)))   &kp LG(LC(LS(Q)))   &kp LA(GRAVE)   &trans          &trans
                                                    &trans         &trans          &trans          &kp C_MUTE
            >;
        };

        /*
         * Num: numpad-style number row with HRM. Right hand mostly unused
         * (spare capacity for future symbol/util keys).
         */
        NUM {
            bindings = <
&trans         &kp N7         &kp N8          &kp N9           &trans          &trans          &trans          &trans          &trans          &trans
&hml LGUI N0    &hml LALT N4   &hml LSHFT N5   &hml LCTRL N6    &trans          &trans          &trans          &trans          &trans          &trans
&trans         &kp N1         &kp N2          &kp N3           &trans          &trans          &trans          &trans          &trans          &trans
                                                    &trans         &trans          &trans          &trans
            >;
        };

        /* Sys: BT select/clear left top row, bootloader/reset on outer thumbs-side. */
        SYS {
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_CLR      &trans          &trans          &trans          &trans          &trans
&trans         &trans         &trans          &trans           &bootloader     &bootloader     &trans          &trans          &trans          &trans
&trans         &trans         &trans          &trans           &sys_reset      &sys_reset      &trans          &trans          &trans          &trans
                                                    &trans         &trans          &trans          &trans
            >;
        };

        /*
         * Mouse: movement/wheel/buttons on the right hand (matches the
         * physical thumb that reaches Nav/Space, and mirrors urob's layout).
         */
        MOUSE {
            bindings = <
&trans         &trans         &trans          &trans           &trans          &trans          &kp PG_UP       &mmv MOVE_UP    &kp PG_DN       &trans
&trans         &trans         &trans          &trans           &trans          &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT &msc SCRL_RIGHT
&trans         &trans         &trans          &trans           &trans          &trans          &mkp LCLK       &mkp MCLK       &mkp RCLK       &trans
                                                    &trans         &trans          &msc SCRL_UP    &msc SCRL_DOWN
            >;
        };
    };
};
