#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define KOR        0
#define ENG        1
#define NAV_MOUSE  2
#define NUM_FUN    3
#define SYM        4
#define MAPLE      5
#define MUTIL      6

/ {
    rf: rapid_fire {
        compatible = "zmk,behavior-rapid-fire";
        #binding-cells = <1>;
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                5 6 7 8 9
                15 16 17 18 19
                25 26 27 28 29
                30 31 32 33
            >;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14
                20 21 22 23 24
                30 31 32 33
            >;
            hold-trigger-on-release;
        };

        /* Tap Esc, hold to switch KOR <-> ENG. */
        bsw: base_switch {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&to>, <&kp>;
        };

        /* Space/NAV_MOUSE tuned independently from other layer-taps. */
        navlt: nav_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <190>;
            quick-tap-ms = <140>;
            bindings = <&mo>, <&kp>;
        };

        /*
         * Backspace:
         * tap = one delete
         * hold = SYM
         * tap-then-hold within quick-tap window = normal repeating Backspace
         */
        bsplt: backspace_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        /* MAPLE: tap key / hold modifier. */
        gmod: game_modifier {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        /* MAPLE Enter: tap Enter / hold MUTIL. */
        gutil: game_utility {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <140>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Existing K+L physical-position combo for Korean/English IME toggle. */
        combo_hangeul {
            timeout-ms = <55>;
            key-positions = <17 18>;
            layers = <KOR ENG>;
            bindings = <&kp LANG1>;
        };

        /* Outer thumbs: game mode ON/OFF. */
        combo_maple_toggle {
            timeout-ms = <80>;
            key-positions = <30 33>;
            layers = <KOR ENG MAPLE>;
            bindings = <&tog MAPLE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Korean QWERTY + HRM */
        KOR {
            bindings = <
&kp Q           &kp W           &kp E            &kp R             &kp T             &kp Y             &kp U             &kp I             &kp O             &kp P
&hml LGUI A      &hml LALT S     &hml LCTRL D     &hml LSHIFT F     &kp G             &kp H             &hmr RSHIFT J     &hmr RCTRL K      &hmr RALT L       &hmr RGUI SEMI
&kp Z           &kp X           &kp C            &kp V             &kp B             &kp N             &kp M             &kp COMMA         &kp DOT           &kp SLASH
                                                       &bsw ENG ESC     &navlt NAV_MOUSE SPACE   &bsplt SYM BACKSPACE   &lt NUM_FUN ENTER
            >;
        };

        /* Gallium Colstag + HRM */
        ENG {
            bindings = <
&kp B           &kp L           &kp D            &kp C             &kp V             &kp J             &kp Y             &kp O             &kp U             &kp COMMA
&hml LGUI N      &hml LALT R     &hml LCTRL T     &hml LSHIFT S     &kp G             &kp P             &hmr RSHIFT H     &hmr RCTRL A      &hmr RALT E       &hmr RGUI I
&kp X           &kp Q           &kp M            &kp W             &kp Z             &kp K             &kp F             &kp APOS          &kp SEMI          &kp DOT
                                                       &bsw KOR ESC     &navlt NAV_MOUSE SPACE   &bsplt SYM BACKSPACE   &lt NUM_FUN ENTER
            >;
        };

        /*
         * NAV + MOUSE on one layer.
         * Right top    = mouse movement + Del
         * Right home   = keyboard arrows + Del
         * Right bottom = mouse buttons + scroll
         */
        NAV_MOUSE {
            bindings = <
&kp ESC         &kp TAB         &kp HOME         &kp PG_UP         &kp END           &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT  &kp DEL
&kp LGUI        &kp LALT        &kp LCTRL        &kp LSHIFT        &kp INS           &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp DEL
&trans          &trans          &trans           &trans            &trans            &mkp LCLK        &mkp RCLK        &mkp MCLK        &msc SCRL_UP     &msc SCRL_DOWN
                                                        &trans          &trans            &trans            &trans
            >;
        };

        /*
         * Combined NUM + F layer.
         * Top    = F1..F10
         * Home   = 1..0
         * Bottom = F11/F12 + editing/system
         */
        NUM_FUN {
            bindings = <
&kp F1          &kp F2          &kp F3           &kp F4            &kp F5            &kp F6            &kp F7            &kp F8            &kp F9            &kp F10
&kp N1          &kp N2          &kp N3           &kp N4            &kp N5            &kp N6            &kp N7            &kp N8            &kp N9            &kp N0
&kp F11         &kp F12         &kp DEL          &kp INS           &kp HOME          &kp END           &kp PG_UP         &kp PG_DN         &kp PSCRN         &kp CAPS
                                                        &trans          &trans            &trans            &trans
            >;
        };

        /* Dedicated symbol layer, held from Backspace. */
        SYM {
            bindings = <
&kp GRAVE       &kp EXCL        &kp AT           &kp HASH          &kp DOLLAR        &kp PERCENT       &kp CARET         &kp AMPS          &kp ASTRK         &kp PLUS
&kp TILDE       &kp MINUS       &kp EQUAL        &kp LPAR          &kp LBKT          &kp RBKT          &kp RPAR          &kp APOS          &kp DQT           &kp PIPE
&kp UNDER       &kp LT          &kp GT           &kp LBRC          &kp BSLH          &kp FSLH          &kp RBRC          &kp SEMI          &kp COLON         &kp QMARK
                                                        &trans          &trans            &trans            &trans
            >;
        };

        /*
         * MAPLE game layer.
         * 26 alphabet keys + direct arrows.
         * Rapid fire: Q W E U H N B G X C.
         */
        MAPLE {
            bindings = <
&rf Q           &rf W           &rf E            &kp R             &kp T             &kp Y             &rf U             &kp UP            &kp O             &kp P
&kp A           &kp S           &kp D            &kp F             &rf G             &rf H             &kp LEFT          &kp DOWN          &kp RIGHT         &kp I
&kp Z           &rf X           &rf C            &kp V             &rf B             &rf N             &kp M             &kp J             &kp K             &kp L
                                                        &gmod LCTRL ESC   &kp SPACE         &gmod LALT BACKSPACE   &gutil MUTIL ENTER
            >;
        };

        /*
         * MAPLE utility.
         * Top = F1..F10
         * Home = 1..0 (1/2/3 rapid-fire)
         * Bottom = F11/F12 + common symbols (' rapid-fire)
         */
        MUTIL {
            bindings = <
&kp F1          &kp F2          &kp F3           &kp F4            &kp F5            &kp F6            &kp F7            &kp F8            &kp F9            &kp F10
&rf N1          &rf N2          &rf N3           &kp N4            &kp N5            &kp N6            &kp N7            &kp N8            &kp N9            &kp N0
&kp F11         &kp F12         &kp MINUS        &kp EQUAL         &kp LBKT          &kp RBKT          &kp SEMI          &rf APOS          &kp COMMA         &kp FSLH
                                                        &kp LSHIFT      &kp LCTRL         &kp LALT          &trans
            >;
        };
    };
};
